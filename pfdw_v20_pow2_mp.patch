+            base_seen        <= 1'b0;
+            pfdw_seen        <= 1'b0;
+            base_dec_latched <= 4'd0;
+            pfdw_dec_latched <= 4'd0;
+        end else begin
+            if (valid_base && !base_seen) begin
+                base_seen        <= 1'b1;
+                base_dec_latched <= decision_base;
+            end
+
+            if (valid_pfdw && !pfdw_seen) begin
+                pfdw_seen        <= 1'b1;
+                pfdw_dec_latched <= decision_pfdw;
