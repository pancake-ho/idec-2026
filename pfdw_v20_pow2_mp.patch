+        $readmemh("data/conv1_weight_1.txt", weight_11);
+        $readmemh("data/conv1_weight_2.txt", weight_12);
+        $readmemh("data/conv1_weight_3.txt", weight_13);
+        $readmemh("data/conv1_bias.txt", bias_1);
+
+        $readmemh("data/conv2_bias.txt", bias_2);
